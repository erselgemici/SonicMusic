@model Sonic_DapperProject.Models.DashboardViewModel
@{
    ViewData["Title"] = "İş Zekası Raporları";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="content-wrapper">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="page-title"> 🚀 Stratejik Analiz Merkezi (BI) </h3>
        <span class="badge badge-outline-success">Canlı Veri Akışı</span>
    </div>

    <div class="row">
        <div class="col-lg-6 grid-margin stretch-card">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title text-warning"><i class="mdi mdi-album"></i> Albüm Performansı</h4>
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead><tr><th>Albüm</th><th>Sanatçı</th><th>Dinlenme</th></tr></thead>
                            <tbody>
                                @foreach (var item in Model.ReportTopAlbums)
                                {
                                    <tr>
                                        <td>@item.AlbumName</td>
                                        <td>@item.ArtistName</td>
                                        <td><label class="badge badge-warning">@item.ListenCount.ToString("N0")</label></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6 grid-margin stretch-card">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title text-info"><i class="mdi mdi-earth"></i> Global Lokasyonlar</h4>
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead><tr><th>Şehir</th><th>Ülke</th><th>Aktivite</th></tr></thead>
                            <tbody>
                                @foreach (var item in Model.ReportTopCities)
                                {
                                    <tr>
                                        <td>@item.CityName</td>
                                        <td>@item.CountryName</td>
                                        <td>
                                            <div class="progress">
                                                <div class="progress-bar bg-info" role="progressbar" style="width: @(item.TotalListens / 3000)%" aria-valuenow="25" aria-valuemin="0" aria-valuemax="100"></div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-6 grid-margin stretch-card">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title text-success"><i class="mdi mdi-chart-line"></i> Yükselen Yıldızlar (Trend)</h4>
                    <p class="text-muted">Son 7 günde dinlenmesini en çok artıran sanatçılar.</p>
                    <div class="table-responsive">
                        <table class="table">
                            <thead><tr><th>Sanatçı</th><th>Bu Hafta</th><th>Büyüme</th></tr></thead>
                            <tbody>
                                @foreach (var item in Model.ReportTrends)
                                {
                                    <tr>
                                        <td>
                                            <span class="font-weight-bold">@item.ArtistName</span>
                                        </td>
                                        <td>@item.ThisWeek.ToString("N0")</td>
                                        <td class="text-success font-weight-bold">
                                            <i class="mdi mdi-arrow-up"></i> %@item.GrowthRate.ToString("N0")
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6 grid-margin stretch-card">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title text-primary"><i class="mdi mdi-clock"></i> Prime Time (Yoğun Saatler)</h4>
                    <p class="text-muted">Sunucuların en yoğun olduğu zaman dilimleri.</p>
                    <div class="table-responsive">
                        <table class="table table-striped">
                            <thead><tr><th>Saat Aralığı</th><th>Trafik</th><th>Durum</th></tr></thead>
                            <tbody>
                                @foreach (var item in Model.ReportPeakHours)
                                {
                                    <tr>
                                        <td>@item.TimeLabel</td>
                                        <td>@item.ListenCount.ToString("N0")</td>
                                        <td>
                                            @if (item.ListenCount > 90000)
                                            {
                                                <label class="badge badge-danger">🔥 Çok Yoğun</label>
                                            }
                                            else if (item.ListenCount > 55000)
                                            {
                                                <label class="badge badge-warning">⚡ Yoğun</label>
                                            }
                                            else if (item.ListenCount > 35000)
                                            {
                                                <label class="badge badge-success">🔵 Normal</label>
                                            }
                                            else
                                            {
                                                <label class="badge badge-outline-secondary">☕ Sakin</label>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-6 grid-margin stretch-card">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title text-danger"><i class="mdi mdi-account-star"></i> Top 10 Süper Fan</h4>
                    <div class="table-responsive">
                        <table class="table">
                            <thead><tr><th>Kullanıcı</th><th>Şehir</th><th>Favori Tür</th></tr></thead>
                            <tbody>
                                @foreach (var item in Model.ReportTopFans)
                                {
                                    <tr>
                                        <td>
                                            <i class="mdi mdi-account-circle text-muted"></i> @item.UserName
                                        </td>
                                        <td>@item.City</td>
                                        <td><label class="badge badge-danger">@item.FavoriteGenre</label></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6 grid-margin stretch-card">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title text-white"><i class="mdi mdi-credit-card"></i> Abonelik Performansı</h4>
                    <div class="table-responsive">
                        <table class="table">
                            <thead><tr><th>Paket Tipi</th><th>Kullanıcı</th><th>Ort. Dinleme</th></tr></thead>
                            <tbody>
                                @foreach (var item in Model.ReportSubscriptions)
                                {
                                    <tr>
                                        <td>
                                            @if (item.SubscriptionType == "Premium")
                                            {
                                                <span class="text-warning">👑 Premium</span>
                                            }
                                            else
                                            {

                                                <span class="text-secondary">Basic / Free</span>
                                            }
                                        </td>
                                        <td>@item.UserCount.ToString("N0")</td>
                                        <td>@item.AvgListenPerUser.ToString("N0") şarkı/kişi</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>
