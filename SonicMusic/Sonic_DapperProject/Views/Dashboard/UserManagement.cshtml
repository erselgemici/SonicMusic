@model Sonic_DapperProject.Models.UserManagementViewModel
@{
    ViewData["Title"] = "Kullanıcı Yönetimi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="content-wrapper">

    <div class="row mb-3">
        <div class="col-md-6">
            <h3 class="page-title">👥 Kullanıcı Yönetimi</h3>
        </div>
        <div class="col-md-6">
            <form method="get" action="/Dashboard/UserManagement">
                <div class="input-group">
                    <input type="text" name="search" class="form-control text-white"
                           placeholder="İsim veya Email ara..." value="@Model.SearchTerm">
                    <button class="btn btn-primary" type="submit">
                        <i class="mdi mdi-magnify"></i> Ara
                    </button>
                    @if (!string.IsNullOrEmpty(Model.SearchTerm))
                    {
                        <a href="/Dashboard/UserManagement" class="btn btn-secondary">Temizle</a>
                    }
                </div>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Kullanıcı</th>
                            <th>Şehir</th>
                            <th>Üyelik</th>
                            <th>Kayıt Tarihi</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Users)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        @{
                                            var names = item.FullName.Trim().Split(' ');
                                            var initials = names[0].Substring(0, 1);
                                            if (names.Length > 1) { initials += names[1].Substring(0, 1); }

                                            var colors = new[] { "primary", "success", "danger", "warning", "info" };
                                            var randomColor = colors[item.UserId % 5]; // ID'ye göre sabit renk (sayfa değişince renk değişmesin)
                                        }
                                        <div class="rounded-circle bg-@randomColor text-white d-flex align-items-center justify-content-center"
                                             style="width: 38px; height: 38px; font-weight: bold; margin-right: 12px;">
                                            @initials
                                        </div>
                                        <div>
                                            <span class="d-block">@item.FullName</span>
                                            <small class="text-muted">@item.Email</small>
                                        </div>
                                    </div>
                                </td>
                                <td>@item.CityName</td>
                                <td>
                                    @if (item.SubscriptionType == "Premium")
                                    {
                                        <span class="badge badge-success">Premium</span>
                                    }
                                    else
                                    {

                                        <span class="badge badge-outline-secondary">Free</span>
                                    }
                                </td>
                                <td>@item.RegisterDate.ToString("dd.MM.yyyy")</td>
                                <td>
                                    <button class="btn btn-sm btn-outline-warning"><i class="mdi mdi-pencil"></i></button>
                                    <button class="btn btn-sm btn-outline-danger"><i class="mdi mdi-delete"></i></button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.TotalPages > 1)
            {
                <div class="d-flex justify-content-center mt-4">
                    <nav>
                        <ul class="pagination">
                            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link" href="/Dashboard/UserManagement?page=@(Model.CurrentPage - 1)&search=@Model.SearchTerm">❮</a>
                            </li>

                            @for (int i = Math.Max(1, Model.CurrentPage - 2); i <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); i++)
                            {
                                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link" href="/Dashboard/UserManagement?page=@i&search=@Model.SearchTerm">@i</a>
                                </li>
                            }

                            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" href="/Dashboard/UserManagement?page=@(Model.CurrentPage + 1)&search=@Model.SearchTerm">❯</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        </div>
    </div>
</div>
